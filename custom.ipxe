#!ipxe
### RogueScholar iPXE Menu
# SPDX-FileCopyrightText: © 2019–2026, RogueScholar <RogueScholar@users.noreply.github.com>
#
# SPDX-License-Identifier: CC0-1.0

set esc:hex 1b
set cls ${esc:string}[2J

set keybase-ipxe https://petermello.net/ipxe
set pmagic-path ${keybase-ipxe}/pmagic
set grml-path   ${keybase-ipxe}/grml
set czilla-path ${keybase-ipxe}/clonezilla

cpair --foreground 2 --background 0 0
console --left 40 --right 40 --top 80 --bottom 80 --depth 24 \
  --picture ${keybase-ipxe}/background.png --keep

dhcp && echo DHCP network interface configuration succeeded!
echo Connection summary:
ifstat; route
echo Greetings, wayfaring stranger.

:main
clear choice
menu --name main Select the desired boot environment or system command:
item --menu main --gap -- ---------------- Parted Magic (v2026_06_04) ----------------
item --menu main --key 0x10 --default pmagic ${space} (P)arted Magic amd64 netsrc+squashfs
item --menu main --gap -- ------------------- Grml Live (2026.04) --------------------
item --menu main --key 0x07 grml             ${space} (G)rml Full amd64 httpfetch+squashfs
item --menu main --gap -- ---------------- Clonezilla Live (v3.3.3-33) ---------------
item --menu main --key 0x03 czilla           ${space} (C)lonezilla amd64 httpfetch+squashfs
item --menu main --gap -- ---------------------- System Commands ---------------------
item --menu main --key 0x09 shell            ${space} Start a new, (i)nteractive iPXE shell
item --menu main --key 0x12 reboot           ${space} (R)eboot
item --menu main --key 0x13 poweroff         ${space} (S)hutdown
item --menu main --gap -- ------------------------------------------------------------
item --menu main --key 0x18 exit             ${space} E(x)it iPXE and continue UEFI boot
item --menu main --gap
item --menu main --gap *** Parenthetical letters select that option when pressed as a chord with <Ctrl> ***
choose --menu main --default exit --timeout 300000 --keep choice || goto main
echo ${cls}
goto ${choice} || goto main

:pmagic
echo Downloading Parted Magic image files from ${pmagic-path}…
echo Fetching kernel…
kernel --name bzImage ${pmagic-path}/bzImage nohibernate noresume nox2apic \
  rw splash edd=on initrd=initrd.img ip=dhcp loglevel=4 vga=normal video=efifb \
  netargs="-A index.html" netsrc=wget neturl="${pmagic-path}/pmodules/"
echo Fetching initramfs…
initrd --name initrd.img ${pmagic-path}/initrd.img
echo Download summary:
imgstat && sleep 3
echo Booting Parted Magic…
imgexec --name bzImage --autofree --replace || goto main

:grml
echo Downloading Grml64 Full image files from ${grml-path}…
echo Fetching kernel…
kernel --name vmlinuz ${grml-path}/vmlinuz hostname noblank noeject nomce \
  noprompt apm=power-off boot=live initrd=initrd.img keyboard=us ssh=password \
  tz=America/Los_Angeles xkeyboard=us \
  fetch="${grml-path}/grml64-full_sid.squashfs"
echo Fetching initramfs…
initrd --name initrd.img ${grml-path}/initrd.img
echo Download summary:
imgstat && sleep 3
echo Booting Grml64 Full…
imgexec vmlinuz || goto main

:czilla
echo Downloading Clonelizza Live image files from ${czilla-path}…
echo Fetching kernel…
kernel --name vmlinuz ${czilla-path}/vmlinuz config noeject noprompt noswap \
  quiet splash boot=live edd=on enforcing=0 hostname=kinetic initrd=initrd.img \
  keyboard-layouts=us locales=en_US.UTF-8 loglevel=0 net.ifnames=0 \
  union=overlay username=user ocs_fontface=Terminus ocs_fontsize=20x10 \
  ocs_live_batch=no ocs_live_run=ocs-live-general \
  fetch="${czilla-path}/filesystem.squashfs"
echo Fetching initramfs…
initrd --name initrd.img ${czilla-path}/initrd.img
echo Download summary:
imgstat && sleep 3
echo Booting Clonezilla Live…
imgexec vmlinuz || goto main

:shell
shell

:reboot
reboot

:poweroff
poweroff

:exit
exit 0
